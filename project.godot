; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Uprising: The Blood Sacrament"
run/main_scene="res://src/levels/test_arena/TestArena.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[autoload]

GlobalEvents="*res://src/core/GlobalEvents.gd"
HitStopManager="*res://src/core/HitStopManager.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[layer_names]

3d_physics/layer_1="Environment"
3d_physics/layer_2="Characters"
3d_physics/layer_3="PlayerHitbox"
3d_physics/layer_4="EnemyHurtbox"
3d_physics/layer_5="PlayerHurtbox"
3d_physics/layer_6="EnemyHitbox"

[rendering]

anti_aliasing/quality/msaa_3d=2
